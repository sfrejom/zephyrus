# =============================================================================
# UAV Fabric Network - Environment Configuration
# =============================================================================
# Resolve mDNS names to IPs before deploying. Replace these placeholders
# or have the setup script inject them at deploy time.
#
#   Example:
#     UAV1_IP=$(getent hosts uav-1.local | awk '{print $1}')
# =============================================================================

# --- Node IP Addresses (resolved from mDNS at setup time) ---
UAV1_IP=192.168.1.101
UAV2_IP=192.168.1.102
UAV3_IP=192.168.1.103
UAV4_IP=192.168.1.104

# --- Fabric Image Versions ---
FABRIC_VERSION=2.5
FABRIC_CA_VERSION=1.5

# --- Channel ---
CHANNEL_NAME=swarm-management

# --- Domain ---
DOMAIN=uav-network.local

# --- Logging ---
FABRIC_LOGGING_SPEC=INFO

# --- Fabric CA bootstrap credentials (change in production) ---
CA_ADMIN_USER=admin
CA_ADMIN_PASSWORD=adminpw

# --- Paths (explicit /home/spilab to avoid issues with $USER/$HOME) ---
FABRIC_BASE_DIR=/home/spilab/uav-fabric-network
ORGANIZATIONS_DIR=${FABRIC_BASE_DIR}/organizations
CHANNEL_ARTIFACTS_DIR=${FABRIC_BASE_DIR}/channel-artifacts

# --- Compose project name ---
COMPOSE_PROJECT_NAME=uav-fabric
